# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase ----------------------------------------------------------------
# Project URL (safe to expose, but kept here for completeness)
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key — SERVER-ONLY. Has full DB access. Never expose to client.
# Used by all server actions / route handlers via lib/supabase-server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key — kept here in case we ever need it from the browser, but the
# current architecture routes everything through the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sessions ----------------------------------------------------------------
# Random 32+ byte hex string. Used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cron --------------------------------------------------------------------
# Shared secret that Vercel cron passes as a header to /api/cron/* so we
# can reject random callers. Generate same way as SESSION_SECRET.
CRON_SECRET=

# Web Push (set up in M5) -------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:andrewwehbe15@gmail.com
